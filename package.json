{
  "name": "git-huddle",
  "version": "0.1.0",
  "description": "Coding agents on different laptops coordinating through the git remote they already share.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevomB/huddle.git"
  },
  "bugs": {
    "url": "https://github.com/DevomB/huddle/issues"
  },
  "homepage": "https://github.com/DevomB/huddle#readme",
  "type": "module",
  "bin": {
    "huddle": "dist/huddle.mjs",
    "git-huddle": "dist/huddle.mjs"
  },
  "files": [
    "dist/huddle.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "release": "npm run build && node scripts/build-release.mjs",
    "smoke:release": "node scripts/mvp-delivery-release.mjs",
    "demo": "node scripts/demo-mvp.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
